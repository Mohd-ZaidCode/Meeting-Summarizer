# Required for live transcription + summarization.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# whisper-1 (OpenAI ASR) or gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Used to turn the transcript into minutes + action items
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# true = skip OpenAI and generate a realistic sample result
# Automatically enabled when OPENAI_API_KEY is empty
DEMO_MODE=false

MAX_UPLOAD_MB=25
DATABASE_URL=sqlite:///./meetings.db
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
